# .env.gcp.example — GCP Cloud SQL 模式範本（透過 cloud-sql-proxy）
#
# 用途：開發階段想對接 GCP 真實 Cloud SQL（lock-ai 實例）時的 .env 來源。
#
# 兩種取得方式：
#   1) 自動（推薦）：./scripts/env/use-gcp.sh --fetch
#      會從 GCP Secret Manager 抓 POSTGRES_URI，自動改寫為 proxy 格式
#      （127.0.0.1:5432）寫入 .env.gcp，再 cp 為 .env
#
#   2) 手動：cp .env.gcp.example .env.gcp，把 <PASSWORD> 換成
#      Secret Manager 中 DB_PASSWORD 的值，最後 cp .env.gcp .env
#
# 啟動完整流程：
#   ./scripts/env/use-gcp.sh --fetch          # 首次：取最新 secret
#   ./scripts/dev/proxy-up.sh                  # 啟 cloud-sql-proxy
#   cd agent && uvicorn app:app --reload --port 8000
#
# 結束：./scripts/dev/proxy-down.sh

# === LLM 語言模型金鑰 ===
GEMINI_API_KEY="<YOUR_GEMINI_API_KEY>"

# === 外部 API 機密設定 ===
ORDER_API_URL="http://localhost:8000/v1/status"
ORDER_API_TOKEN="<YOUR_ORDER_API_TOKEN>"

# === PostgreSQL — 透過 cloud-sql-proxy 連 GCP Cloud SQL ===
# proxy 把 cedar-scope-489604-g3:asia-east1:lock-ai 對映到本機 127.0.0.1:5432
POSTGRES_URI="postgresql://lock:<DB_PASSWORD>@127.0.0.1:5432/lock_AI_data"
PG_VECTOR_URI="postgresql+psycopg://lock:<DB_PASSWORD>@127.0.0.1:5432/lock_AI_data"

# === Vertex AI 設定（使用 ADC 驗證） ===
VERTEX_PROJECT_ID="cedar-scope-489604-g3"
VERTEX_LOCATION="us-central1"

# === LINE CHANNEL ===
LINE_CHANNEL_SECRET="<YOUR_LINE_CHANNEL_SECRET>"
LINE_CHANNEL_ACCESS_TOKEN="<YOUR_LINE_CHANNEL_ACCESS_TOKEN>"

# === OPIK LLM Observability ===
OPIK_API_KEY="<YOUR_OPIK_API_KEY>"
OPIK_WORKSPACE="<YOUR_OPIK_WORKSPACE>"

# === API JWT 簽名金鑰（api 服務專用，不是 Vertex / OPIK 那些） ===
# 生成方式：openssl rand -hex 32
# Cloud Run 部署：./scripts/deploy/api.sh 會建 API_JWT_SECRET_KEY secret
API_JWT_SECRET_KEY="<RANDOM_HEX_32_BYTES>"
