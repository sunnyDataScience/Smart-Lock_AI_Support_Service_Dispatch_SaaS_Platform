# .env.example — 複製為 .env 並填入實際值

# === LLM 語言模型金鑰 ===
GEMINI_API_KEY="your_gemini_api_key"

# === Ollama 遠端伺服器網址 (若在本地執行則可留空或註解) ===
# OLLAMA_BASE_URL="http://192.168.1.100:11434"

# === 外部 API 機密設定 ===
ORDER_API_URL="http://localhost:8000/v1/status"
ORDER_API_TOKEN="your_order_api_token"

# === PostgreSQL 資料庫連線 ===
PG_VECTOR_URI="postgresql+psycopg://user:password@localhost:5433/db_name"
POSTGRES_URI="postgresql://user:password@localhost:5433/db_name"

# === Vertex AI 設定 ===
VERTEX_PROJECT_ID="your_gcp_project_id"
VERTEX_LOCATION="us-central1"

# === LINE CHANNEL 機密設定 ===
LINE_CHANNEL_SECRET="your_line_channel_secret"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token"

# === 對話旁路持久化（方案 A：LINE agent gateway → API → conversations/messages）===
# API 端：驗 X-Internal-Token 用（fail closed，未設則 ingest 端點一律 503）。
# agent gateway 端：呼叫 ingest 端點時帶同一把 token。生成：openssl rand -hex 32
INTERNAL_API_TOKEN="your_internal_service_token"
# agent gateway 端：API 服務 base URL（如 http://localhost:8080 或 Cloud Run URL）。
# 未設 INTERNAL_API_TOKEN 或 LOCK_API_BASE_URL → gateway 安靜略過持久化（不破壞既有部署）。
LOCK_API_BASE_URL="http://localhost:8080"

# === GCS 媒體存儲 (Cloud Run 部署時使用) ===
GCS_MEDIA_BUCKET="your_gcs_bucket_name"

# === OPIK LLM Observability (Comet) ===
OPIK_API_KEY="your_opik_api_key"
OPIK_WORKSPACE="your_opik_workspace"

# === API JWT 簽名金鑰（api 服務專用，不是 Vertex / OPIK 那些） ===
# 生成方式：openssl rand -hex 32
# Cloud Run 部署：./scripts/deploy/api.sh 會建 API_JWT_SECRET_KEY secret
API_JWT_SECRET_KEY="<RANDOM_HEX_32_BYTES>"
