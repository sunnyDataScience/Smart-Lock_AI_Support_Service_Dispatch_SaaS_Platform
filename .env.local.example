# .env.local.example — 本機 docker DB 模式範本
#
# 用途：開發階段使用本機 PostgreSQL container（lock_AI）+ seed 假資料。
#
# 設定流程：
#   cp .env.local.example .env.local        # 複製範本
#   # 編輯 .env.local 填入你個人的 GEMINI_API_KEY / LINE token / OPIK key
#   ./scripts/env/use-local.sh                # 套用：cp .env.local .env
#
# 啟動完整流程：
#   ./scripts/dev/dev-up.sh                   # 起 DB + ngrok + uvicorn
#   或：./scripts/dev/dev-up.sh --db-only     # 只起 DB

# === LLM 語言模型金鑰 ===
GEMINI_API_KEY="<YOUR_GEMINI_API_KEY>"

# === Ollama 遠端伺服器（可選） ===
# OLLAMA_BASE_URL="http://192.168.1.100:11434"

# === 外部 API 機密設定 ===
ORDER_API_URL="http://localhost:8000/v1/status"
ORDER_API_TOKEN="<YOUR_ORDER_API_TOKEN>"

# === PostgreSQL — 本機 docker container (port 5433) ===
# dev-up.sh 起的 container 預設帳密是 lock / 0000
PG_VECTOR_URI="postgresql+psycopg://lock:0000@localhost:5433/lock_AI_data"
POSTGRES_URI="postgresql://lock:0000@localhost:5433/lock_AI_data"

# === Vertex AI 設定（使用 ADC，不需 API Key） ===
VERTEX_PROJECT_ID="cedar-scope-489604-g3"
VERTEX_LOCATION="us-central1"

# === GCS 媒體存儲（選用覆寫；未設則用 config.toml 的 gcs_bucket="lock-ai"） ===
# GCS_MEDIA_BUCKET="your_gcs_bucket_name"

# === LINE CHANNEL ===
LINE_CHANNEL_SECRET="<YOUR_LINE_CHANNEL_SECRET>"
LINE_CHANNEL_ACCESS_TOKEN="<YOUR_LINE_CHANNEL_ACCESS_TOKEN>"

# === OPIK LLM Observability ===
OPIK_API_KEY="<YOUR_OPIK_API_KEY>"
OPIK_WORKSPACE="<YOUR_OPIK_WORKSPACE>"

# === API JWT 簽名金鑰（api 服務專用，不是 Vertex / OPIK 那些） ===
# 生成方式：openssl rand -hex 32
# Cloud Run 部署：./scripts/deploy/api.sh 會建 API_JWT_SECRET_KEY secret
API_JWT_SECRET_KEY="<RANDOM_HEX_32_BYTES>"
