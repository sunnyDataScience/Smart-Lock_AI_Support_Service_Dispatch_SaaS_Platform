{
  "name": "@smartlock/shared-contract",
  "version": "0.1.0",
  "description": "Versioned API/security contracts shared by Smart Lock web portals",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api-generated": {
      "types": "./dist/api-generated.d.ts",
      "default": "./dist/api-generated.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./mutation": {
      "types": "./dist/mutation.d.ts",
      "default": "./dist/mutation.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "default": "./dist/capability.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:boundary": "node scripts/check-boundary.mjs",
    "prepack": "npm run check:boundary && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
