{
  "name": "smartlock-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:dispatch": "npm run build -w apps/dispatch",
    "build:tech": "npm run build -w apps/tech",
    "build:landing": "npm run build -w apps/landing",
    "build:platform": "npm run build -w apps/platform",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
