# brands/locksmart.env — 參考品牌(現行 prod)部署參數
#
# AI-3(20260702 會議 §三「一品牌一 GCP 專案 + 獨立 DB」):每個品牌一份
# <brand>.env,由 scripts/deploy/{api,web,agent}.sh 以 `BRAND=<name>` 載入。
# 本檔值 = 各腳本內建預設(未設 BRAND 時行為相同),作為新品牌的抄寫範本。
#
# 新品牌上線步驟(仿神通 SI 模式):
#   1. 建 GCP 專案 + Artifact Registry repo + service account + Cloud SQL 實例
#   2. Secret Manager 建同名 secrets(POSTGRES_URI/API_JWT_SECRET_KEY/
#      INTERNAL_API_TOKEN/LINE_CHANNEL_SECRET/LINE_CHANNEL_ACCESS_TOKEN/
#      OPIK_API_KEY/OPIK_WORKSPACE)—— secrets 名稱跨品牌一致,不需參數化
#   3. 複製本檔為 brands/<brand>.env 改值
#   4. BRAND=<brand> ./scripts/deploy/api.sh(web.sh / agent.sh 同)
#
# 注意:師傅平台(tech stack)全品牌共用、不做每品牌部署(CR-0112);
# 雲端目前為單庫 fallback 模式(TECH_POSTGRES_URI 未設),技師庫雲端接入
# 屬 AI-2/AI-3 後續設計。

# GCP 專案與區域
PROJECT_ID="cedar-scope-489604-g3"
REGION="asia-east1"
REPO="lock-ai-repo"
SERVICE_ACCOUNT="lock-ai@${PROJECT_ID}.iam.gserviceaccount.com"

# Cloud Run service 名(api/web/agent 各自的腳本只用到自己的 SERVICE_NAME;
# 跨服務解析用 API_SERVICE_NAME / WEB_SERVICE_NAME)
# api.sh:  SERVICE_NAME="smart-lock-api"
# web.sh:  SERVICE_NAME="smart-lock-web"
# agent.sh:SERVICE_NAME="smart-lock-agent"
# ※ SERVICE_NAME 由各腳本自帶預設,品牌檔通常不用覆蓋;要改名才設。
API_SERVICE_NAME="smart-lock-api"
WEB_SERVICE_NAME="smart-lock-web"

# Cloud SQL
CLOUDSQL_INSTANCE="${PROJECT_ID}:${REGION}:lock-ai"
DB_USER="lock-ai"
DB_NAME="lock-ai-db"

# agent 別名租戶 → 真實租戶 UUID(api internal_ingest._resolve_tenant_id)
AGENT_TENANT_ID="00000000-0000-0000-0000-000000000001"
