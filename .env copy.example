# ============================================================
# 唯一 .env — 前端 (Vite) + 後端 (FastAPI) 共用
# 複製此檔案為 .env，填入你的值
# ============================================================


# ── Supabase ─────────────────────────────────────────────────
# 前後端共用同一組變數（VITE_ prefix 讓 Vite 也能讀取）
# 後端 config.py 透過 validation_alias 直接讀 VITE_* 變數，不需重複宣告
#
# 取得方式：
#   1. 登入 https://supabase.com/dashboard
#   2. 選擇你的專案 → Settings → API
#   3. 頁面上方可看到 Project URL 和 API Keys

# Project Reference ID（Settings → General → Reference ID）
VITE_SUPABASE_PROJECT_ID=

# Project URL（Settings → API → Project URL）
VITE_SUPABASE_URL=

# anon / public key（Settings → API → anon public）
VITE_SUPABASE_PUBLISHABLE_KEY=

# service_role key（Settings → API → service_role，點 Reveal）
# ⚠️ 正式環境不應在前端暴露此 key
VITE_SUPABASE_SERVICE_ROLE_KEY=


# ── Auth ─────────────────────────────────────────────────────

# 認證模式（正式流程必須為 false）
VITE_DEV_BYPASS_AUTH=false

# Supabase JWT Secret（後端驗證 token 用，必填）
# 取得方式：Supabase Dashboard → Settings → API → JWT Secret（點 Reveal）
JWT_SECRET=


# ── LLM Provider ──────────────────────────────────────────────
# 切換 AI 引擎（只需改這一行，系統自動選用對應的 API Key + 模型）
# 可選值: "anthropic" | "openai" | "azure_openai" | "gemini" | "qwen"

LLM_PROVIDER=anthropic

# ── Anthropic Claude API ─────────────────────────────────────
# 取得方式：
#   1. 登入 https://console.anthropic.com
#   2. 左側選單 → API Keys → Create Key
#   3. 複製 sk-ant-api03-... 開頭的 key
# 計費：按 token 用量，詳見 https://anthropic.com/pricing

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Anthropic API 要求必填 max_tokens，設為模型的最大輸出容量（不限制 AI 輸出長度）
ANTHROPIC_MAX_OUTPUT_TOKENS=16384

# ── OpenAI API ───────────────────────────────────────────────
# 取得方式：
#   1. 登入 https://platform.openai.com
#   2. API Keys → Create new secret key
#   3. 複製 sk-... 開頭的 key

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ── Azure AI — Anthropic Claude or OpenAI ─────────────────────
# 支援兩種模式：
#   A. Azure Anthropic Claude（推薦）：
#      BASE_URL = https://<resource>.services.ai.azure.com/anthropic/
#      MODEL = claude-opus-4-20250514 / claude-sonnet-4-20250514 / claude-haiku-35-20241022
#      系統自動偵測 URL 含 "anthropic" → 走 Anthropic SDK
#   B. Azure OpenAI：
#      BASE_URL = https://<resource>.cognitiveservices.azure.com/openai/v1/
#      MODEL = gpt-4o / gpt-4o-mini
#
# 取得方式：Azure Portal → AI Services 資源 → Keys and Endpoint

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEFAULT_MODEL=
AZURE_OPENAI_FAST_MODEL=

# ── Google Gemini API ──────────────────────────────────────
# 取得方式：
#   1. 登入 https://aistudio.google.com
#   2. Get API key → Create API key
#   3. 複製 AIza... 開頭的 key
# 使用 OpenAI-compatible endpoint，無需額外安裝 SDK

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.0-flash-lite

# ── Alibaba Qwen 通義千問 API ─────────────────────────────
# 取得方式：
#   1. 登入 https://dashscope.console.aliyun.com
#   2. API-KEY 管理 → 建立 API Key
#   3. 複製 sk-... 開頭的 key
# 使用 DashScope OpenAI-compatible endpoint

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-turbo


# ── Tavily Web Search（選填）─────────────────────────────────
# AI 建議約束/KPI 時即時搜尋 ISO 標準、法規作為佐證，避免幻覺
# 取得方式：
#   1. 註冊 https://tavily.com
#   2. Dashboard → API Keys → 複製 tvly-... 開頭的 key
# 計費：免費 1,000 次搜尋/月
# 不填 = AI 功能正常，但不附帶外部參考來源

TAVILY_API_KEY=


# ── Backend 設定 ─────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000/api/v1
TRIZ_KB_PATH=../rd_assistant_design_system/triz_knowledge_base
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
