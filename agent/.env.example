# agent/.env.example — 複製為 agent/.env 並填入實際值。
#
# ⚠️ 重要：line_gateway.py 讀的是【agent/.env】（load_dotenv(scripts/../.env)），
#    不是專案根目錄的 .env。在 agent/ 跑 gateway 的人，憑證與橋接設定要放這份。
#    非機密的模型 / 記憶後端設定走 agent/config.toml；機密只放這裡（已 gitignore）。

# === LINE 通道機密（gateway 必需，缺則啟動即退出）===
LINE_CHANNEL_SECRET="your_line_channel_secret"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token"

# === API 橋接（方案 A + CR-0022）===
# 設了這兩個，gateway 才會把「每輪對話」與「轉真人 → AI 草擬問題卡」旁路寫進 API
# （conversations/messages + escalations ingest），後台 /conversations 與工單系統才看得到。
# 兩者缺一 → gateway 啟動時印「API 橋接:停用」並安靜略過（不破壞無此設定的部署）。
# token 必須與 API 進程的 INTERNAL_API_TOKEN 完全一致（API 端 fail-closed：未設→503、不符→401）。
# 本機開發預設可用 dev-internal-token；正式環境用 openssl rand -hex 32。
INTERNAL_API_TOKEN="dev-internal-token"
LOCK_API_BASE_URL="http://localhost:8001"

# === Postgres 記憶後端（僅當 config.toml [memory] backend = "postgres" 時需要，CR-0023）===
# 預設 backend = "sqlite" 用本地 memory.db，不需這個。
# POSTGRES_URI="postgresql://lock:0000@localhost:5433/lock_AI_data"
