---
config:
  theme: base
  themeVariables:
    primaryColor: '#4A90D9'
    primaryTextColor: '#000'
    primaryBorderColor: '#2E6CB5'
    lineColor: '#333333'
    secondaryColor: '#E8F5E9'
    tertiaryColor: '#FFF3E0'
  layout: elk
---
graph TD
    LINE_USER(("LINE 使用者"))

    subgraph entry_layer ["入口層（app.py）"]
        direction TB
        webhook["webhook<br/><small>POST /webhook<br/>HMAC 簽名驗證<br/>顯示 Loading 動畫</small>"]
        chat_test["chat_test<br/><small>GET /chat?q=<br/>快速測試端點</small>"]
        health["health<br/><small>GET /health<br/>version: 2.0-skills</small>"]
    end

    subgraph invoke_layer ["Agent 呼叫層（debounce.py agent_and_reply + run_agent）"]
        direction TB
        safety_gate_node["H6 安全閘門 + H_DC 資料修正<br/><small>safety_gate.check() 攔截危險指令<br/>data_correction.check_and_save() 攔截 #資料修正<br/>Quick Reply 品牌/型號收集（含模糊匹配）</small>"]
        load_profile["載入用戶畫像 + 品牌自動推論<br/><small>ProfileManager.load_full_profile_with_facts<br/>infer_brand_from_text() 自動推論品牌<br/>filter_skills(brand, model)<br/>注入 [可用技能] + [用戶資料] 前綴</small>"]
        agent_invoke["agent.ainvoke<br/><small>傳入 messages + thread_id<br/>Checkpointer 管理對話記憶</small>"]
        safety_gate_node --> load_profile
        output_validate["H7.5 輸出驗證<br/><small>output_validator.py<br/>禁用語 regex + LLM 語意檢查<br/>不合規 → 重跑 ReAct loop</small>"]
        skill_cleanup["H10 Checkpoint 清理<br/><small>_cleanup_tool_checkpoint<br/>SOP → [已參考技能: xxx]</small>"]
        extract_reply["提取回覆<br/><small>從 messages 取最後一則 AI 回覆<br/>處理 str / list[dict] 格式</small>"]
        load_profile --> agent_invoke
        agent_invoke --> skill_cleanup
        skill_cleanup --> output_validate
        output_validate --> extract_reply
    end

    subgraph react_agent ["ReAct Agent（LangGraph create_react_agent）"]
        direction TB
        system_prompt["System Prompt<br/><small>prompts/system.md<br/>動態 [可用技能] 注入（63 技能）<br/>安全規則 + 回覆風格</small>"]
        llm_reason["LLM 推理<br/><small>讀取 system prompt + messages<br/>決定是否需要載入技能<br/>產生 tool_calls 或直接回覆</small>"]
        tool_exec["Tool 執行<br/><small>執行 load_skill / transfer_to_human<br/>結果回饋給 LLM</small>"]
        llm_reason -->|"tool_calls"| tool_exec
        tool_exec -->|"tool results"| llm_reason
    end

    subgraph skills_layer ["技能系統（skills/ — 67 個 SKILL.md）"]
        direction TB
        skill_registry["技能註冊表<br/><small>skills/__init__.py<br/>掃描品牌目錄結構<br/>路徑推斷 brands/models<br/>filter_skills(brand, model)</small>"]

        subgraph common_skills ["_common 通用技能（7 個）"]
            direction LR
            sk_troubleshoot["troubleshoot<br/><small>故障排除路由器</small>"]
            sk_product["product-knowledge<br/><small>品牌/型號/規格</small>"]
            sk_store["store-info<br/><small>門市資訊</small>"]
            sk_dispatch["dispatch-guide<br/><small>派工/安裝</small>"]
        end

        subgraph brand_skills ["品牌專屬技能（56 個 × 8 品牌）"]
            direction LR
            sk_dorm["Dormakaba<br/><small>7 個 ts-*/ss-*</small>"]
            sk_chat["Chatlock<br/><small>19 個（含 AI-99）</small>"]
            sk_others["其他品牌<br/><small>Philips/Kaadas/Milre<br/>AiLock/3E/Waferlock<br/>各 5 個</small>"]
        end
    end

    subgraph tools_layer ["Tools（skills/tools.py）"]
        direction LR
        tool_load["load_skill(name)<br/><small>載入完整 SOP 內容<br/>回傳 Markdown 格式</small>"]
        tool_transfer["transfer_to_human(reason)<br/><small>收集客戶資訊<br/>產生轉接表單</small>"]
    end

    subgraph prompts_layer ["Prompt 模板（prompts/）"]
        direction LR
        prompt_system[("system.md<br/><small>系統指令 + 技能列表<br/>回覆風格 + 安全規則</small>")]
        prompt_transfer_form[("transfer_human.md<br/><small>轉接真人表單模板</small>")]
    end

    subgraph config_layer ["設定驅動（config.toml — 14 sections）"]
        direction LR
        cfg_system[("system<br/><small>domain / agent_name<br/>request_timeout</small>")]
        cfg_llm[("llm<br/><small>provider / model_name<br/>temperature</small>")]
        cfg_line[("line_bot<br/><small>channel_secret<br/>loading_seconds</small>")]
        cfg_memory[("memory<br/><small>type: memory<br/>sqlite / postgres</small>")]
        cfg_skills[("skills<br/><small>data_dir</small>")]
        cfg_prompts[("prompts<br/><small>system_prompt<br/>transfer_human_form</small>")]
        cfg_safety[("safety<br/><small>dangerous_keywords</small>")]
        cfg_profile[("user_profile<br/><small>enabled / profile_dir<br/>facts_enabled</small>")]
    end

    subgraph ai_engines ["AI 引擎（Registry 模式）"]
        direction LR
        llm_registry["LLM Registry<br/><small>llms/__init__.py<br/>get_llm(config)</small>"]
        embed_registry["Embedding Registry<br/><small>embeddings/__init__.py<br/>get_embedding(config)</small>"]

        subgraph llm_providers ["LLM Providers"]
            direction LR
            llm_ollama["Ollama<br/><small>ChatOllama</small>"]
            llm_gemini["Gemini<br/><small>ChatGoogleGenerativeAI</small>"]
            llm_vertexai["Vertex AI<br/><small>ChatGoogleGenerativeAI<br/>vertexai=True</small>"]
        end

        subgraph embed_providers ["Embedding Providers"]
            direction LR
            embed_ollama["Ollama<br/><small>OllamaEmbeddings</small>"]
            embed_vertexai["Vertex AI<br/><small>GoogleGenerativeAIEmbeddings</small>"]
        end
    end

    subgraph memory_layer ["對話記憶（Memory Registry）"]
        direction LR
        mem_registry["Memory Registry<br/><small>memory/__init__.py<br/>get_checkpointer(config)</small>"]
        mem_memory["MemorySaver<br/><small>In-process<br/>開發用</small>"]
        mem_sqlite["AsyncSqliteSaver<br/><small>WAL mode<br/>本地持久化</small>"]
        mem_postgres["AsyncPostgresSaver<br/><small>分散式<br/>生產環境</small>"]
    end

    subgraph profile_layer ["用戶畫像（profiles/）"]
        direction LR
        profile_mgr["ProfileManager<br/><small>profiles/manager.py</small>"]
        profile_md[("Markdown Profiles<br/><small>./data/profiles/*.md<br/>用戶歷史摘要</small>")]
        profile_facts[("PostgreSQL Facts<br/><small>user_facts 表<br/>SCD Type 2 upsert</small>")]
    end

    subgraph quality_layer ["品質保證（quality/）"]
        direction LR
        qc_runner["quality_check.py<br/><small>67 測試案例<br/>7 類別 (H/S/W/Y/M/G/B)<br/>多輪模擬 + 品牌注入</small>"]
        qc_keyword["關鍵字比對<br/><small>≥50% 命中 = 通過</small>"]
        qc_judge["LLM-as-Judge<br/><small>pass / partial / fail</small>"]
        qc_report[("quality_report<br/><small>.json + .html<br/>儀表板 + 篩選表格</small>")]
    end

    %% === 主流程連線 ===
    LINE_USER -->|"傳送訊息"| webhook
    webhook -->|"文字訊息"| safety_gate_node
    chat_test -->|"測試訊息"| agent_invoke
    extract_reply -->|"Reply / Push API"| LINE_USER

    %% === Agent 內部連線 ===
    agent_invoke --> llm_reason
    tool_exec -->|"load_skill"| tool_load
    tool_exec -->|"transfer_to_human"| tool_transfer
    tool_load --> skill_registry
    skill_registry --> common_skills
    skill_registry --> brand_skills

    %% === Prompt 連線 ===
    prompt_system --- system_prompt
    prompt_transfer_form --- tool_transfer

    %% === AI 引擎連線 ===
    llm_registry --> llm_providers
    embed_registry --> embed_providers
    cfg_llm -.->|"provider 選擇"| llm_registry
    llm_registry -.->|"ChatModel"| llm_reason

    %% === Memory 連線 ===
    mem_registry --> mem_memory
    mem_registry --> mem_sqlite
    mem_registry --> mem_postgres
    cfg_memory -.->|"type 選擇"| mem_registry
    mem_registry -.->|"Checkpointer"| agent_invoke

    %% === Profile 連線 ===
    profile_mgr --> profile_md
    profile_mgr --> profile_facts
    cfg_profile -.->|"enabled"| profile_mgr
    profile_mgr -.->|"load_full_profile"| load_profile

    %% === 品質保證連線 ===
    qc_runner --> qc_keyword
    qc_runner --> qc_judge
    qc_runner --> qc_report

    %% === 樣式定義 ===
    classDef userNode fill:#A5D6A7,stroke:#388E3C,color:#000,stroke-width:2px
    classDef entry fill:#FFE0B2,stroke:#F57C00,color:#000,stroke-width:1px
    classDef invoke fill:#BBDEFB,stroke:#1976D2,color:#000,stroke-width:1px
    classDef react fill:#C8E6C9,stroke:#43A047,color:#000,stroke-width:2px
    classDef skill_tier1 fill:#E8F5E9,stroke:#66BB6A,color:#000,stroke-width:1px
    classDef skill_tier2 fill:#FFF3E0,stroke:#FFA726,color:#000,stroke-width:1px
    classDef tool_style fill:#B2EBF2,stroke:#0097A7,color:#000,stroke-width:1px
    classDef prompt_style fill:#E1BEE7,stroke:#7B1FA2,color:#000,stroke-width:1px
    classDef config_style fill:#FFF9C4,stroke:#F9A825,color:#000,stroke-width:1px
    classDef llm_style fill:#90CAF9,stroke:#1565C0,color:#000,stroke-width:2px
    classDef provider_style fill:#BBDEFB,stroke:#42A5F5,color:#000,stroke-width:1px
    classDef memory_style fill:#CFD8DC,stroke:#455A64,color:#000,stroke-width:1px
    classDef profile_style fill:#F3E5F5,stroke:#8E24AA,color:#000,stroke-width:1px
    classDef persist fill:#D7CCC8,stroke:#5D4037,color:#000,stroke-width:1px
    classDef quality_style fill:#FFCDD2,stroke:#E53935,color:#000,stroke-width:1px

    class LINE_USER userNode
    class webhook,chat_test,health entry
    class safety_gate_node,load_profile,agent_invoke,output_validate,skill_cleanup,extract_reply invoke
    class system_prompt,llm_reason,tool_exec react
    class skill_registry react
    class sk_troubleshoot,sk_product,sk_store,sk_dispatch skill_tier1
    class sk_dorm,sk_chat,sk_others skill_tier2
    class tool_load,tool_transfer tool_style
    class prompt_system,prompt_transfer_form prompt_style
    class cfg_system,cfg_llm,cfg_line,cfg_memory,cfg_skills,cfg_prompts,cfg_safety,cfg_profile config_style
    class llm_registry,embed_registry llm_style
    class llm_ollama,llm_gemini,llm_vertexai,embed_ollama,embed_vertexai provider_style
    class mem_registry memory_style
    class mem_memory,mem_sqlite,mem_postgres persist
    class profile_mgr profile_style
    class profile_md,profile_facts persist
    class qc_runner,qc_keyword,qc_judge quality_style
    class qc_report persist
