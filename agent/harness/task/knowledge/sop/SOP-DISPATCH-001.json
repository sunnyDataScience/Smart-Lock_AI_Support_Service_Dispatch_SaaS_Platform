{
  "_doc": "SOP: Dispatch decision — when to dispatch a technician vs remote solve. Based on real domain error code data.",
  "id": "SOP-DISPATCH-001",
  "category": "dispatch",
  "title": "派工決策標準流程",
  "version": "1.0",
  "owner": "維修部",

  "principle": "能遠端解決的絕不派工，必須派工的快速排程。派工決策基於品牌錯誤碼和物理檢測結果。",

  "steps": [
    {
      "id": "check_dispatch_signals",
      "label": "檢查派工必要信號",
      "description": "比對品牌錯誤碼，若出現以下信號則直接進入派工流程",
      "dispatch_required_signals": [
        {
          "brand": "dormakaba",
          "signal": "紅燈閃4次",
          "meaning": "馬達異常",
          "failure_mode": "FM-MECH-002",
          "urgency": "high"
        },
        {
          "brand": "dormakaba",
          "signal": "紅燈常亮",
          "meaning": "系統錯誤",
          "failure_mode": "FM-ELEC-002",
          "urgency": "high"
        },
        {
          "brand": "Philips",
          "signal": "紅燈閃3次",
          "meaning": "離合器異常",
          "failure_mode": "FM-MECH-003",
          "urgency": "high"
        },
        {
          "brand": "Kaadas",
          "signal": "紅燈閃5次",
          "meaning": "馬達堵轉",
          "failure_mode": "FM-MECH-004",
          "urgency": "high"
        },
        {
          "brand": "Milre",
          "signal": "面板全亮後熄滅",
          "meaning": "主機板異常",
          "failure_mode": "FM-ELEC-001",
          "urgency": "high"
        },
        {
          "brand": "all",
          "signal": "門扇反弓（門框與門扇間隙不均）",
          "meaning": "門扇物理變形",
          "failure_mode": "FM-MECH-005",
          "urgency": "medium"
        },
        {
          "brand": "all",
          "signal": "承接板嚴重偏位（用戶無法自行調整）",
          "meaning": "需現場重新校準",
          "failure_mode": "FM-MECH-006",
          "urgency": "medium"
        }
      ]
    },
    {
      "id": "check_remote_solvable",
      "label": "確認遠端可解決",
      "description": "以下問題可透過電話/LINE指導用戶自行解決，不需派工",
      "remote_solvable_issues": [
        {
          "issue": "電池電量不足",
          "fix": "更換Panasonic鹼性電池",
          "signals": ["短嗶3聲(dormakaba)", "語音電量不足(Philips)", "語音請更換電池(Kaadas)", "嗶聲4次(Milre)", "語音電池電量低(AiLock)"]
        },
        {
          "issue": "驗證失敗（資料未儲存）",
          "fix": "實體鑰匙開門→重新註冊",
          "signals": ["面板閃爍6(dormakaba)"]
        },
        {
          "issue": "雙重驗證模式誤啟用",
          "fix": "管理員密碼→*→8",
          "signals": ["密碼和卡片各自單獨都不行但無錯誤碼"]
        },
        {
          "issue": "Wi-Fi連線問題",
          "fix": "確認2.4GHz頻段，禁用Wi-Fi 6",
          "signals": ["間歇嗶聲每30秒(AiLock)", "Wi-Fi無法連線"]
        },
        {
          "issue": "指紋辨識失敗",
          "fix": "清潔感應器→重新註冊指紋",
          "signals": ["紅燈閃2次(dormakaba)", "短嗶3聲+紅燈(AiLock)", "短嗶3聲+黃燈(Kaadas)"]
        },
        {
          "issue": "門扇卡死（間隙問題）",
          "fix": "推緊門扇→解鎖→保持推緊開門",
          "signals": ["馬達有聲音但門打不開"]
        },
        {
          "issue": "權限混淆",
          "fix": "說明管理員密碼vs一般密碼差異",
          "signals": ["密碼可開門但無法進設定"]
        }
      ]
    },
    {
      "id": "remote_attempt",
      "label": "遠端修復嘗試",
      "description": "依據故障樹驗證鏈指導用戶操作，最多3輪問答",
      "max_rounds": 3,
      "timeout_action": "若3輪仍無法解決，建議到府檢測"
    },
    {
      "id": "dispatch_quote",
      "label": "派工報價",
      "description": "確認需派工後，查詢價目表提供報價",
      "quote_includes": ["檢測費（維修可折抵）", "零件費（依實際更換）", "工資"],
      "warranty_check": "確認購買日期與保固狀態"
    },
    {
      "id": "technician_match",
      "label": "技師匹配",
      "description": "根據品牌專長、服務地區、排程空檔匹配最合適技師",
      "match_criteria": [
        "品牌專長（技師需有該品牌維修認證）",
        "服務地區（距客戶最近）",
        "排程空檔（最早可用時段）",
        "故障類型專長（馬達/主板/安裝等）"
      ]
    },
    {
      "id": "schedule_confirm",
      "label": "排程確認",
      "description": "與客戶確認到府時間，發送預約確認通知"
    },
    {
      "id": "dispatch_execute",
      "label": "派工執行",
      "description": "指派工單給技師，附完整診斷資訊和客戶聯絡方式"
    }
  ],

  "decision_points": [
    {"at_step": "check_dispatch_signals", "condition": "出現派工必要信號", "action": "跳過remote_attempt，直接進入dispatch_quote"},
    {"at_step": "check_remote_solvable", "condition": "符合遠端可解決條件", "action": "進入remote_attempt嘗試遠端修復"},
    {"at_step": "remote_attempt", "condition": "遠端修復成功", "action": "結案，不需派工"},
    {"at_step": "remote_attempt", "condition": "3輪未解決", "action": "進入dispatch_quote"},
    {"at_step": "technician_match", "condition": "無可用技師", "action": "排入候補佇列，告知預計等待時間"},
    {"at_step": "technician_match", "condition": "緊急案件（Red_Code）", "action": "優先排程，必要時調度其他技師"}
  ],

  "emergency_override": {
    "condition": "Red_Code緊急案件（被鎖在外面、家中有小孩等）",
    "action": "跳過標準排程，立即派遣最近可用技師",
    "sla": "2小時內到場"
  }
}
